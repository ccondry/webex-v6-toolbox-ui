{
  "name": "wxcc-demo-toolbox-ui",
  "version": "2025.10.29",
  "description": "UI for the dCloud Webex Contact Center Instant Demo Toolbox",
  "license": "MIT",
  "keywords": [
    "cisco",
    "dcloud",
    "contact-center",
    "contact",
    "center",
    "pcce",
    "uccx",
    "webex",
    "cjp"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "npm run serve",
    "postinstall": "husky install",
    "serve": "rollup -c -w",
    "size": "npm run build && size-limit",
    "start": "npm run serve"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@momentum-ui/core": "^19.15.7",
    "@vue/babel-preset-app": "^4.5.11",
    "blueimp-md5": "^2.12.0",
    "buefy": "0.9.29",
    "chart.js": "^2.9.4",
    "chartjs-plugin-datalabels": "^1.0.0",
    "focus-trap": "^5.0.2",
    "js-yaml": "^4.0.0",
    "lodash": "^4.17.15",
    "luxon": "^1.25.0",
    "marked": "^4.0.18",
    "moment": "^2.25.3",
    "moment-mini": "^2.24.0",
    "moment-timezone": "^0.5.31",
    "no-scroll": "^2.1.1",
    "vue": "2.7.16",
    "vue-chartjs": "^3.5.1",
    "vue-qr": "^2.5.0",
    "vue-router": "^3.1.3",
    "vuex": "^3.1.2",
    "weekstart": "^1.0.1"
  },
  "peerDependencies": {
    "postcss": "^8.3.5"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "4.0.2",
    "@rollup/plugin-commonjs": "23.0.2",
    "@rollup/plugin-image": "3.0.1",
    "@rollup/plugin-json": "5.0.1",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-replace": "5.0.1",
    "@size-limit/file": "^11.2.0",
    "cssnano": "5.1.14",
    "esbuild": "^0.25.0",
    "generate-source-map": "^0.0.5",
    "husky": "8.0.2",
    "lint-staged": "13.0.3",
    "postcss": "^8.5.32",
    "postcss-import": "15.0.0",
    "postcss-nested": "6.0.0",
    "postcss-preset-env": "7.8.3",
    "postcss-sort-media-queries": "4.3.0",
    "postcss-url": "^10.1.4",
    "prettier": "^2.5.1",
    "prettier-package-json": "2.7.0",
    "rollup": "2.80.0",
    "rollup-plugin-cleaner": "^1.0.0",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-esbuild": "5.0.0",
    "rollup-plugin-import-resolver": "^1.2.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-require-context": "^1.0.1",
    "rollup-plugin-serve": "2.0.1",
    "rollup-plugin-visualizer": "5.8.3",
    "rollup-plugin-vue": "^5.1.9",
    "size-limit": "^11.2.0",
    "vue-loader": "17.0.1",
    "vue-template-compiler": "^2.7.16"
  },
  "overrides": {
    "@vue/component-compiler-utils": {
      "postcss": "$postcss"
    },
    "postcss-modules-sync": {
      "postcss": "$postcss"
    },
    "generic-names": {
      "loader-utils": "^1.4.2"
    },
    "source-map-resolve": {
      "decode-uri-component": "^0.5.1"
    },
    "rollup-plugin-serve": {
      "mime": "^3.0.0"
    }
  },
  "lint-staged": {
    "*.{js,json,vue},!dist/*.js": [
      "prettier --write",
      "git add"
    ],
    "package.json": [
      "prettier-package-json  --write",
      "git add"
    ]
  },
  "size-limit": [
    {
      "path": "dist/webex-v6/app.js"
    }
  ]
}
